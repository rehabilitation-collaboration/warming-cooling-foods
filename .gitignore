# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# Mac
.DS_Store

# Raw fetched HTML (not redistributed; sources.csv records provenance)
data/sources_raw/

# Inter-coder reconciliation intermediates (coder JSON dumps, merge output,
# per-source adjudication verdicts, adopted-record staging, generated literal
# block). Only the reconciled claims.csv and the kappa reported in Methods are
# public.
data/coder1_*.json
data/coder2_*.json
data/reconciliation_*.csv
data/adjudicate/
data/round2_adopted.json
data/round2_claims_block.txt

# Axis B raw API responses. The count responses (L1/L2/L3 PubMed, OpenAlex,
# CiNii) ARE published: they pin every reported count to the query snapshot and
# carry no third-party content. Only the efetch record dumps are withheld, since
# those are full PubMed titles and abstracts; they are regenerable with
# fetch_l2_records.py, and every PMID in them appears in screening.csv.
data/query_log/*_L2_records.json

# Axis B L2 raw records (full PubMed titles+abstracts, not redistributed;
# regenerable via fetch_l2_records.py). The public outputs are
# screening_golden.csv (titles only) and screening.csv.
data/l2_records.csv

# L2 screening intermediates (per-coder record dumps + per-coder CSVs, mirrors
# the Axis A coder-JSON policy). Only the reconciled screening.csv is public.
data/screening_work/

# Internal development docs (excluded from public repository)
PLAN.md
PLAN-DEVIATIONS.md
LITERATURE.md
REVIEW-REPORT.md
GPT-REVIEW-*.md

# SSRN submission guide (internal workflow tool, not a reproducibility artifact)
ssrn-submission.html

# Reference-verification pre-processing output (audit artifact, regenerable
# via verify_refs.py; the public reference list lives in manuscript.md)
output/reference_verification.md
output/reference_verification.json

# Tier1 目視 audit の作業シート (内部作業物)
AUDIT-tier1-checklist.md
